# --- Supabase (proyecto dedicado "fantasy-bets") ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- Fuente de partidos/cuotas en el cliente ---
# supabase -> lee la tabla matches_cache (poblada por la edge function refresh-odds)
# mock     -> datos ficticios para desarrollo local sin pipeline
VITE_ODDS_PROVIDER=supabase

# La API key de The Odds API ya NO va en el cliente.
# Se configura como secret del proyecto Supabase:  THE_ODDS_API_KEY
# (Dashboard > Project Settings > Edge Functions > Secrets, o `supabase secrets set`)

# --- App Android (Capacitor) ---
# Google OAuth 2.0 Client ID de tipo "Web application" (el mismo que configuras en
# el provider Google de Supabase). Lo usa el login nativo del APK.
VITE_GOOGLE_WEB_CLIENT_ID=

# --- RevenueCat (suscripción premium, solo APK) ---
# API key PÚBLICA de Android (empieza con goog_). Segura en el cliente.
VITE_REVENUECAT_ANDROID_KEY=
# Secrets del proyecto Supabase (NO aquí):
#   REVENUECAT_SECRET_KEY       -> Secret API key de RevenueCat (Project > API keys)
#   REVENUECAT_WEBHOOK_SECRET   -> el "Authorization header value" del webhook de RC

# --- AdMob (anuncios, solo APK, solo plan free) ---
# Vacío = usa los IDs de PRUEBA de Google (no generan ingresos).
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
# El App ID de AdMob va en android/app/src/main/AndroidManifest.xml
