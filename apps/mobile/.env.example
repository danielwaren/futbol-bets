# --- Supabase (proyecto dedicado "fantasy-bets") ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- Fuente de partidos/cuotas ---
# supabase -> lee matches_cache (poblada por la edge function refresh-odds)
# mock     -> fixtures deterministas para desarrollo local sin pipeline
EXPO_PUBLIC_ODDS_PROVIDER=supabase

# --- Login nativo de Google (solo dev build / EAS, NO Expo Go) ---
# OAuth 2.0 Client ID de tipo "Web application" (el mismo del provider Google de Supabase).
# Vacío = en Expo Go solo funciona el acceso por email.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- RevenueCat (suscripción premium, solo dev build) ---
# API key PÚBLICA de Android (empieza con goog_). Segura en el cliente.
# Vacío = paywall informativo, sin compras.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- AdMob (anuncios, solo dev build, solo plan free) ---
# Vacío = sin anuncios (o IDs de prueba de Google).
EXPO_PUBLIC_ADMOB_BANNER_ID=
